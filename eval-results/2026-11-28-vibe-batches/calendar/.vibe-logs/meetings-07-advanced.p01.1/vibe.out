        "summary": "bash: cd /home/salboaie/work/sopworlds/soplang-nlu/eval-results/2026-11-28-vibe-batches/calendar && python3 - <<'EOF'\nimport json,csv,re,collections\nV=[json.loads(l) for l in open('meetings-07-advanced.p01.verdicts.jsonl')]\nrows={int(r['n']):r for r in csv.DictReader(open('meetings-07-advanced.p01.csv'))}\nprint(\"lines\",len(V))\nprint(\"ns ok\", sorted(v['n'] for v in V)==sorted(rows))\nprint(collections.Counter(v['grade'] for v in V))\nprint(\"empty notes\",sum(1 for v in V if not v['note'].strip()))\nprint(\"rejections missing sop\",[v['n'] for v in V if v['grade']!='L8' and not v.get('sop')])\nprint(\"L8 with sop\",[v['n'] for v in V if v['grade']=='L8' and v.get('sop')])\n# structure check on sops: declared ids and referenced ids\nbad=[]\nfor v in V:\n    s=v.get('sop')\n    if not s: continue\n    ids=set(re.findall(r'^@([A-Za-z0-9_]+) ',s,re.M))\n    refs=set(re.findall(r'\\$([A-Za-z0-9_]+)',s))\n    miss=refs-ids\n    if miss: bad.append((v['n'],sorted(miss)))\nprint(\"dangling refs\",bad)\n# word coverage check\ndef words(t):\n    return re.findall(r\"[A-Za-z0-9:>\\-'’\\.]+\", t.lower())\nfor v in V:\n    s=v.get('sop')\n    if not s: continue\n    t=rows[v['n']]['text']\n    vals=re.findall(r'=\\$?(\"[^\"]*\"|[^ \\n]+)',s)\n    toks=[]\n    for x in vals:\n        x=x.strip('\"').lower()\n        if x.startswith('$'): continue\n        toks.extend(re.findall(r\"[A-Za-z0-9:>\\-'’\\.]+\",x))\n    tw=[w for w in words(t) if w not in ('.',',',':',';','?','!','-','>','->')]\n    tw2=[w.strip('.') for w in tw]\n    c1=collections.Counter(toks); c2=collections.Counter(tw2)\n    missing=[w for w in c2 if c1[w]<c2[w] and w not in ('n\\'t',)]\n    extra=[w for w in c1 if c1[w]>c2[w]]\n    if missing or extra:\n        print(\"COVER n\",v['n'],\"missing\",missing[:8],\"extra\",extra[:8])\nEOF",
        "content": null,
        "suffix": "",
