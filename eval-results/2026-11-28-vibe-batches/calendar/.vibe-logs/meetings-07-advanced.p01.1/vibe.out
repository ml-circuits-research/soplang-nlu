      "display": {
        "summary": "bash: cd /home/salboai/work/../home/salboaie/work/sopworlds/soplang-nlu/eval-results/2026-11-28-vibe-batches/calendar && python3 - <<'PYEOF'\nimport json\nrows=[\n(180,\"L8\",\"Accepted: 'Oak room' is the subject of the nonfinite 'renamed', with 'Oak hall' the end of the relation marked 'to'.\",None),\n(182,\"L8\",\"Accepted: 'facilities renamed all the rooms after rivers' takes 'after rivers' as a relation from the clause, and 'so the Board room is now Danube' is joined to it.\",None),\n(185,\"L8\",\"Accepted: 'let' is the verb of the command with 's' as its complement, and 'sounds odd to clients' and 'go with Think tank instead' are tied to it.\",None),\n(186,\"L3\",\"The words 'Cedar 2' are what the sign says, but they are written as a fragment and made a third conjunct of the coordination, so the content of 'says' is lost and the coordination has a conjunct the message does not relate.\",'''@c1 syntax.clause form=declarative discourse=\"ok\" modifier=\"so\" modifier=\"outside\" modifier=\"now\" verb=\"says\" subject=$n1 complement=$n2\n@n1 syntax.nominal dependent=\"the\" head=\"sign\"\n@n2 syntax.nominal dependent=\"Cedar\" head=\"2\"\n@c2 syntax.clause form=imperative discourse=\"please\" verb=\"update\" complement=$n4\n@n4 syntax.nominal dependent=\"the\" dependent=\"cedar\" head=\"room\"\n@r1 syntax.relation marker=\"to\" from=$c2 to=$c3\n@c3 syntax.clause form=nonfinite verb=\"match\"\n@k1 syntax.coordination conjunct=$c1 conjunct=$c2'''),\n(187,\"L8\",\"Accepted: 'Board room -> Main room' is a fragment whose two nominals are tied, with the arrow held in the clause.\",None),\n(193,\"L8\",\"Accepted: 'Cedar room' is a fragment tied side by side to the command 'rename to Willow'.\",None),\n(197,\"L8\",\"Accepted: the question keeps its auxiliary, subject and complement, with 'so it seats 16' tied to it.\",None),\n(199,\"L8\",\"Accepted: 'Focus pod capacity' is the subject of 'should be' and '3 people' its complement.\",None),\n(201,\"L8\",\"Accepted: 'we moved two extra chairs into the Focus pod' is joined by 'so' to 'it holds 4 people now', which keeps its subject, verb and time word.\",None),\n(202,\"L3\",\"In 'because of the new distancing rules' the linking word 'of' is made the head of a nominal and 'the new distancing rules' is taken as complement of 'take', so the phrase is split and tied to the wrong clause.\",'''@c1 syntax.clause form=declarative auxiliary=\"can\" modifier=\"only\" verb=\"take\" subject=$n3 complement=$n4\n@n1 syntax.nominal dependent=\"the\" dependent=\"new\" dependent=\"distancing\" head=\"rules\"\n@r1 syntax.relation marker=\"because of\" from=$c1 to=$n1\n@n3 syntax.nominal dependent=\"the\" dependent=\"Board\" head=\"room\"\n@n4 syntax.nominal dependent=\"9\" head=\"people\"\n@c2 syntax.clause form=imperative discourse=\"please\" verb=\"update\" complement=$n5\n@n5 syntax.nominal head=\"it\"\n@r2 syntax.relation from=$c2 to=$c1'''),\n(203,\"L8\",\"Accepted: 'the Cedar room got the big table back' and the question 'Could you bump it up to 12 seats?' are each placed with their parts.\",None),\n(206,\"L8\",\"Accepted: 'hey' is a discourse word, 'the Oak room was rebuilt' a clause of its own, and 'space for 30 people' tied by 'for'.\",None),\n(209,\"L8\",\"Accepted: 'it seats 5' is a declarative clause with subject, verb and complement.\",None),\n(210,\"L8\",\"Accepted: the fragment 'focus pod, capacity 2 please' ties 'capacity' to 'focus pod' and '2' to 'capacity', with 'please' as discourse.\",None),\n(215,\"L8\",\"Accepted: 'the Board room is now in building C' keeps its subject, verb and the relation marked 'in'.\",None),\n(218,\"L8\",\"Accepted: 'please update the cedar room' is joined to 'it's next to the kitchen now', whose 'next to the kitchen' is a relation from that clause.\",None),\n(221,\"L8\",\"Accepted: 'we swapped floors with marketing' is joined by 'so' to 'the Focus pod is up on the 6th floor now', which keeps 'up' and 'on the 6th floor'.\",None),\n(223,\"L8\",\"Accepted: 'move the Cedar room to building A' and 'rename it Cedar A' are commands joined by 'and' with their complements and relations intact.\",None),\n(224,\"L8\",\"Accepted: 'ca' and 'n't' hold the negation of 'find', and 'would you note that it's behind reception, past the coffee machine?' carries the reported clause with both relations from it.\",None),\n(225,\"L8\",\"Accepted: 'if the Oak room really is in the basement now' is tied to the command 'please update', and 'where it is' states with 'where' a modifier and is tied to that command.\",None),\n(226,\"L8\",\"Accepted: 'after the office move' and 'at 40 King Street' are relations from the clause, '2nd floor' is tied to the address, and the question 'can you fix that?' keeps its parts.\",None),\n(227,\"L8\",\"Accepted: 'this room moved upstairs' is written as one clause with 'this room' as subject, 'moved' as verb and 'upstairs' as a modifier, which the next layer can read on.\",None),\n(233,\"L8\",\"Accepted: 'Board room moved to floor 9' keeps its clause, its subject and the relation marked 'to' with '9' tied to 'floor'.\",None),\n(236,\"L8\",\"Accepted: 'please get rid of the board room' is a command with 'of the board room' tied to it.\",None),\n(238,\"L8\",\"Accepted: 'the Focus pod' is the subject of the nonfinite 'removed' with 'as a room' tied to it.\",None),\n(243,\"L8\",\"Accepted: 'if no one has the Library booked' is tied to 'you can delete that room', with 'booked' a nonfinite clause over 'the Library'.\",None),\n(244,\"L8\",\"Accepted: 'the building closed the old Annex for good' and the question 'would you mind removing it from the rooms?' are joined, and 'from the rooms' starts at 'removing'.\",None),\n]\nwith open('meetings-07-advanced.p01.verdicts.jsonl','a') as f:\n    for n,g,note,sop in rows:\n        d={\"n\":n,\"grade\":g,\"note\":note}\n        if sop: d[\"sop\"]=sop\n        f.write(json.dumps(d,ensure_ascii=False)+\"\\n\")\nprint(sum(1 for _ in open('meetings-07-advanced.p01.verdicts.jsonl')))\nPYEOF",
