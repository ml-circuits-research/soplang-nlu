        "stdout": "n,text,sop,label_state\n1,Make my avatar a man.,\"@c1 syntax.clause form=imperative verb=\"\"Make\"\" complement=$n1 complement=$n2\n@n1 syntax.nominal dependent=\"\"my\"\" head=\"\"avatar\"\"\n@n2 syntax.nominal dependent=\"\"a\"\" head=\"\"man\"\"\",agreement\n2,My avatar should be a male figure.,\"@n1 syntax.nominal dependent=\"\"My\"\" head=\"\"avatar\"\"\n@c1 syntax.clause form=declarative auxiliary=\"\"should\"\" verb=\"\"be\"\" subject=$n1 complement=$n2\n@n2 syntax.nominal dependent=\"\"a\"\" dependent=\"\"male\"\" head=\"\"figure\"\"\",agreement\n3,Set my avatar to the man.,\"@c1 syntax.clause form=imperative verb=\"\"Set\"\" complement=$n1\n@n1 syntax.nominal dependent=\"\"my\"\" head=\"\"avatar\"\"\n@r1 syntax.relation marker=\"\"to\"\" from=$c1 to=$n2\n@n2 syntax.nominal dependent=\"\"the\"\" head=\"\"man\"\"\",agreement\n4,Switch my avatar to a man figure.,\"@c1 syntax.clause form=imperative verb=\"\"Switch\"\" complement=$n1\n@n1 syntax.nominal dependent=\"\"my\"\" head=\"\"avatar\"\"\n@r1 syntax.relation marker=\"\"to\"\" from=$c1 to=$n2\n@n2 syntax.nominal dependent=\"\"a\"\" dependent=\"\"man\"\" head=\"\"figure\"\"\",agreement\n5,Use a guy for my avatar.,\"@c1 syntax.clause form=imperative verb=\"\"Use\"\" complement=$n1\n@n1 syntax.nominal dependent=\"\"a\"\" head=\"\"guy\"\"\n@r1 syntax.relation attachment=ambiguous marker=\"\"for\"\" from=$c1 to=$n2\n@n2 syntax.nominal dependent=\"\"my\"\" head=\"\"avatar\"\"\",agreement\n6,\"I'd like a man character for the avatar, please.\",\"@n1 syntax.nominal head=\"\"I\"\"\n@c1 syntax.clause form=declarative auxiliary=\"\"'d\"\" verb=\"\"like\"\" discourse=\"\"please\"\" subject=$n1 complement=$n2\n@n2 syntax.nominal dependent=\"\"a\"\" dependent=\"\"man\"\" head=\"\"character\"\"\n@r1 syntax.relation marker=\"\"for\"\" from=$n2 to=$n3\n@n3 syntax.nominal dependent=\"\"the\"\" head=\"\"avatar\"\"\",agreement\n7,Choose the male figure for my avatar.,\"@c1 syntax.clause form=imperative verb=\"\"Choose\"\" complement=$n1\n@n1 syntax.nominal dependent=\"\"the\"\" dependent=\"\"male\"\" head=\"\"figure\"\"\n@r1 syntax.relation marker=\"\"for\"\" from=$n1 to=$n2\n@n2 syntax.nominal dependent=\"\"my\"\" head=\"\"avatar\"\"\",agreement\n8,Pick a man for me.,\"@c1 syntax.clause form=imperative verb=\"\"Pick\"\" complement=$n1\n@n1 syntax.nominal dependent=\"\"a\"\" head=\"\"man\"\"\n@r1 syntax.relation attachment=ambiguous marker=\"\"for\"\" from=$c1 to=$n2\n@n2 syntax.nominal head=\"\"me\"\"\",agreement\n9,Keep my avatar as a male figure.,\"@c1 syntax.clause form=imperative verb=\"\"Keep\"\" complement=$n1\n@n1 syntax.nominal dependent=\"\"my\"\" head=\"\"avatar\"\"\n@r1 syntax.relation attachment=ambiguous marker=\"\"as\"\" from=$c1 to=$n2\n@n2 syntax.nominal dependent=\"\"a\"\" dependent=\"\"male\"\" head=\"\"figure\"\"\",agreement\n11,The avatar should be a guy.,\"@n1 syntax.nominal dependent=\"\"The\"\" head=\"\"avatar\"\"\n@c1 syntax.clause form=declarative auxiliary=\"\"should\"\" verb=\"\"be\"\" subject=$n1 complement=$n2\n@n2 syntax.nominal dependent=\"\"a\"\" head=\"\"guy\"\"\",agreement\n12,My preference is the male option.,\"@n1 syntax.nominal dependent=\"\"My\"\" head=\"\"preference\"\"\n@c1 syntax.clause form=declarative verb=\"\"is\"\" subject=$n1 complement=$n2\n@n2 syntax.nominal dependent=\"\"the\"\" dependent=\"\"mal",
