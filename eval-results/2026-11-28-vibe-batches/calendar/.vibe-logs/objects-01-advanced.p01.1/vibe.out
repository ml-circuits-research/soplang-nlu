      "display": {
        "summary": "bash: cd /home/salboaie/work/sopworlds/soplang-nlu/eval-results/2026-11-28-vibe-batches/drawing && python3 - <<'EOF'\nimport json,re,csv\nrows={int(r['n']):r['text'] for r in csv.DictReader(open('objects-01-advanced.p01.csv'))}\nfor l in open('objects-01-advanced.p01.verdicts.jsonl'):\n    r=json.loads(l)\n    if 'sop' not in r: continue\n    ids=set(); errs=[]\n    for line in r['sop'].splitlines():\n        m=re.match(r'@(\\w+)\\s+(syntax\\.\\w+)',line)\n        if not m: errs.append('bad line: '+line); continue\n        if m.group(1) in ids: errs.append('dup '+m.group(1))\n        ids.add(m.group(1))\n    refs=set(re.findall(r'\\$(\\w+)',r['sop']))\n    miss=refs-ids\n    # word coverage\n    words=re.findall(r'\"([^\"]+)\"',r['sop'])\n    txt=rows[r['n']].replace(',',' ').replace('.',' ').replace('?',' ').replace(';',' ').replace(':',' ')\n    tw=[w for w in txt.split() if w]\n    from collections import Counter\n    print(r['n'], 'dup/errs',errs, 'missing refs',miss)\n    print('   words in circuit:',Counter(words))\n    print('   words in text   :',Counter(tw))\nEOF",
        "content": null,
