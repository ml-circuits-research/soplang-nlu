        "summary": "bash: cd /home/salboaie/work/sopworlds/soplang-nlu/eval-results/2026-11-28-vibe-batches/drawing && python3 - <<'EOF'\nimport csv, json\nrows=list(csv.DictReader(open('objects-01-advanced.p01.csv')))\nns=[int(r['n']) for r in rows]\nrecs=[json.loads(l) for l in open('objects-01-advanced.p01.verdicts.jsonl')]\nrecs.sort(key=lambda r: r['n'])\nassert [r['n'] for r in recs]==ns, 'order mismatch'\nwith open('objects-01-advanced.p01.verdicts.jsonl','w') as f:\n    for r in recs:\n        out={\"n\":r[\"n\"],\"grade\":r[\"grade\"],\"note\":r[\"note\"]}\n        if \"sop\" in r: out[\"sop\"]=r[\"sop\"]\n        f.write(json.dumps(out, ensure_ascii=False)+\"\\n\")\nprint('written', len(recs))\nEOF\nwc -l objects-01-advanced.p01.verdicts.jsonl && head -3 objects-01-advanced.p01.verdicts.jsonl && grep -c '\"grade\": \"L8\"' objects-01-advanced.p01.verdicts.jsonl",
