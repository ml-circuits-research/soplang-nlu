nSOP:\n@r1 syntax.relation marker=\"If\" from=$c2 to=$c1\n@n1 syntax.nominal head=\"you\"\n@c1 syntax.clause form=declarative verb=\"can\" subject=$n1\n@c2 syntax.clause form=imperative verb=\"set\" complement=$n2\n@n2 syntax.nominal dependent=\"my\" head=\"avatar\"\n@r2 syntax.relation marker=\"to\" from=$c2 to=$n3\n@n3 syntax.nominal dependent=\"the\" dependent=\"male\" head=\"option\"\n@k1 syntax.coordination conjunction=\"and\" conjunct=$c2 conjunct=$c3\n@c3 syntax.clause form=imperative verb=\"keep\" complement=$n4\n@n4 syntax.nominal head=\"it\"\n@r3 syntax.relation marker=\"for\" from=$c3 to=$n5\n@n5 syntax.nominal dependent=\"the\" dependent=\"next\" head=\"time\"\n@n6 syntax.nominal head=\"I\"\n@c4 syntax.clause form=declarative verb=\"open\" subject=$n6 complement=$n7\n@n7 syntax.nominal dependent=\"the\" head=\"app\"\n@r4 syntax.relation attachment=ambiguous marker=\"on\" from=$c4 to=$n8\n@n8 syntax.nominal dependent=\"this\" head=\"machine\"\n@r5 syntax.relation from=$n5 to=$c4\n~~~~\n",
