        "summary": "bash: cd /tmp/judge && python3 - <<'EOF'\nimport json\nL8=[222,223,228,229,230,231,232,233,234,235,236,239,240,246,247,250,251,264,265,268,269,271,278,281,282,283,287,288,289,290,292,294,295,296,299,300,302,304,305,306,307,309,311,314,315,319,322,324,326,327,328,331,335,336,339,340,342,344,345,346,347,348,350,351,352,353]\nrecs=[{\"n\":n,\"grade\":\"L8\",\"note\":\"\"} for n in L8]\ncorr349={\"n\":349,\"grade\":\"L3\",\"note\":\"'my avatar' is the thing 'make' makes the robot into, but the circuit makes it the complement of the participle 'painted' in 'the robot but painted blue my avatar', so the nominal hangs on the wrong clause.\",\n\"sop\":\"@c1 syntax.clause form=imperative discourse=\\\"Please\\\" verb=\\\"make\\\" complement=$n1 complement=$n2\\n@n1 syntax.nominal dependent=\\\"the\\\" head=\\\"robot\\\"\\n@c2 syntax.clause form=nonfinite verb=\\\"painted\\\" modifier=\\\"blue\\\"\\n@r4 syntax.relation marker=\\\"but\\\" from=$n1 to=$c2\\n@n2 syntax.nominal dependent=\\\"my\\\" head=\\\"avatar\\\"\\n@r1 syntax.relation marker=\\\"because\\\" from=$c1 to=$k2\\n@n3 syntax.nominal head=\\\"that\\\"\\n@c3 syntax.clause form=declarative verb=\\\"is\\\" subject=$n3\\n@c4 syntax.clause form=declarative modifier=\\\"how\\\" verb=\\\"know\\\" modifier=\\\"here\\\" subject=$n4 complement=$n5\\n@n4 syntax.nominal head=\\\"people\\\"\\n@n5 syntax.nominal head=\\\"me\\\"\\n@k2 syntax.coordination conjunction=\\\"and\\\" conjunct=$c3 conjunct=$c5\\n@n6 syntax.nominal head=\\\"I\\\"\\n@c5 syntax.clause form=declarative auxiliary=\\\"do\\\" negation=\\\"not\\\" verb=\\\"want\\\" subject=$n6\\n@n7 syntax.nominal head=\\\"it\\\"\\n@r2 syntax.relation marker=\\\"to\\\" from=$c5 to=$c6\\n@c6 syntax.clause form=nonfinite verb=\\\"change\\\" subject=$n7\\n@r3 syntax.relation from=$c3 to=$c4\"}\nrecs.append(corr349)\nrecs.sort(key=lambda r: r[\"n\"])\nwith open('/tmp/judge/p3.jsonl','w') as f:\n    for r in recs: f.write(json.dumps(r)+\"\\n\")\nprint(len(recs))\nEOF",
