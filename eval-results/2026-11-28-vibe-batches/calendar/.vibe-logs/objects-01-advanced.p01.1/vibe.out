\n@c1 syntax.clause form=imperative verb=\"Give\" complement=$n1 complement=$n2\n@n1 syntax.nominal head=\"me\"\n@n2 syntax.nominal dependent=\"the\" head=\"robot\"\n@k1 syntax.coordination conjunction=\"but\" conjunct=$c1 conjunct=$c2\n@c2 syntax.clause form=nonfinite verb=\"painted\" modifier=\"blue\"\n@r1 syntax.relation marker=\"for\" from=$c2 to=$n3\n@n3 syntax.nominal dependent=\"the\" head=\"avatar\"\n~~~~\n#136 n=336 | Remember that I want a robot that is blue.\n@c1 syntax.clause form=imperative verb=\"Remember\"\n@r1 syntax.relation marker=\"that\" from=$c1 to=$c2\n@n1 syntax.nominal head=\"I\"\n@c2 syntax.clause form=declarative verb=\"want\" subject=$n1 complement=$n2\n@n2 syntax.nominal dependent=\"a\" head=\"robot\"\n@r2 syntax.relation marker=\"that\" from=$n2 to=$c3\n@c3 syntax.clause form=declarative verb=\"is\" modifier=\"blue\"\n~~~~\n",
