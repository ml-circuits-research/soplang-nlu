 conjunction=\"plus\" conjunct=$c1 conjunct=$c2 conjunct=$c5 conjunct=$c6\n   @c6 syntax.clause form=imperative verb=\"show\" complement=$n12\n   @n12 syntax.nominal dependent=\"the\" head=\"percentages\"\n",
