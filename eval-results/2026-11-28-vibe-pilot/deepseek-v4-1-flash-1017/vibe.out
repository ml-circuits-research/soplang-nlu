  {
    "id": "effect-a84892cb-9ad3-5424-9a79-13891edf7da4",
    "sessionId": "b772b8ea-8170-467e-555e-9fc85999e4b2",
    "turnId": "turn-d792420e5f94f63905461fcce86b1635",
    "inputEntryId": "user-turn-d792420e5f94f63905461fcce86b1635-1",
