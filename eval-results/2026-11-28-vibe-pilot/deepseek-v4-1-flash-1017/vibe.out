    "state": {
      "status": "completed",
      "output": {
        "stdout": "=== n=1 TEXT: never put the sun anywhere but on the right, always, right there in the scene\n   @n1 syntax.nominal dependent=\"the\" head=\"sun\"\n   @r1 syntax.relation marker=\"but on\" from=$c1 to=$n2\n   @n2 syntax.nominal dependent=\"the\" head=\"right\"\n   @c1 syntax.clause form=imperative negation=\"never\" verb=\"put\" modifier=\"anywhere\" modifier=\"always\" modifier=\"right\" modifier=\"there\" complement=$n1\n   @r2 syntax.relation marker=\"in\" from=$c1 to=$n3\n   @n3 syntax.nominal dependent=\"the\" head=\"scene\"\n\n=== n=2 TEXT: delete linee e1\n   @c1 syntax.clause form=imperative verb=\"delete\" complement=$n1\n   @n1 syntax.nominal dependent=\"linee\" head=\"e1\"\n\n=== n=3 TEXT: no, the cloud goes to the top — otherwise it hides the sun otherwise\n   @c1 syntax.clause form=declarative discourse=\"no\" modifier=\"otherwise\" verb=\"hides\" modifier=\"otherwise\" subject=$n3 complement=$n4\n   @n1 syntax.nominal dependent=\"the\" head=\"cloud\"\n   @c2 syntax.clause form=declarative verb=\"goes\" subject=$n1\n   @r1 syntax.relation marker=\"to\" from=$c2 to=$n2\n   @n2 syntax.nominal dependent=\"the\" head=\"top\"\n   @n3 syntax.nominal head=\"it\"\n   @n4 syntax.nominal dependent=\"the\" head=\"sun\"\n   @k1 syntax.coordination conjunct=$c1 conjunct=$c2\n\n=== n=4 TEXT: a sad for me, eyebrow yellow default\n   @c1 syntax.clause form=fragment discourse=\"a\" complement=$n1\n   @n1 syntax.nominal dependent=\"sad\" dependent=\"eyebrow\" dependent=\"yellow\" head=\"default\"\n   @r1 syntax.relation marker=\"for\" from=$n1 to=$n2\n   @n2 syntax.nominal head=\"me\"\n\n=== n=5 TEXT: move block 7 three spaces left, then block 7 one space right\n   @c1 syntax.clause form=imperative verb=\"move\" modifier=\"left\" complement=$n1 complement=$n3\n   @n1 syntax.nominal head=\"block\"\n   @n2 syntax.nominal head=\"7\"\n   @n3 syntax.nominal dependent=\"three\" head=\"spaces\"\n   @k1 syntax.coordination conjunction=\"then\" conjunct=$c1 conj