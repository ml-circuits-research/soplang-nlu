"cat\"\n   @n2 syntax.nominal head=\"260\"\n   @c2 syntax.clause form=imperative verb=\"Take\" complement=$n2 complement=$n3\n   @n3 syntax.nominal head=\"2\"\n   @k1 syntax.coordination conjunct=$c1 conjunct=$c2\n",
