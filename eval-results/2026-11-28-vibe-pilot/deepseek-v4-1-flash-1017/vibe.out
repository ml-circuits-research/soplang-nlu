rst pass how about line thinner? and then let's have the marker borders thicker on the revenue trend, then we revisit next week, also put the y axis on the right\n   @n1 syntax.nominal head=\"I\"\n   @c1 syntax.clause form=declarative verb=\"walked\" subject=$n1 complement=$n2 complement=$n4\n   @n2 syntax.nominal dependent=\"the\" head=\"team\"\n   @r1 syntax.relation marker=\"through\" from=$c1 to=$n3\n   @n3 syntax.nominal dependent=\"Revenue\" head=\"trend\"\n   @n4 syntax.nominal dependent=\"this\" head=\"morning\"\n   @n5 syntax.nominal head=\"nobody\"\n   @r2 syntax.relation marker=\"with\" from=$c2 to=$n6\n   @n6 syntax.nominal dependent=\"the\" head=\"data\"\n   @r3 syntax.relation marker=\"with\" from=$c2 to=$c3\n   @c3 syntax.clause form=declarative modifier=\"how\" verb=\"reads\" subject=$n7\n   @c2 syntax.clause form=interrogative verb=\"argued\" modifier=\"only\" modifier=\"how\" subject=$n5\n   @n7 syntax.nominal head=\"it\"\n   @r4 syntax.relation marker=\"at\" from=$c3 to=$n8\n   @n8 syntax.nominal dependent=\"a\" head=\"glance\"\n   @k1 syntax.coordination conjunction=\"so\" conjunction=\"and\" conjunct=$c1 conjunct=$c2 conjunct=$c4 conjunct=$c7 conjunct=$c8\n   @r5 syntax.relation marker=\"as\" from=$c2 to=$n9\n   @n9 syntax.nominal dependent=\"a\" dependent=\"first\" head=\"pass\"\n   @r6 syntax.relation marker=\"about\" from=$c2 to=$n10\n   @n10 syntax.nominal head=\"line\" dependent=\"thinner\"\n   @c4 syntax.clause form=imperative modifier=\"then\" verb=\"let\" complement=$n11\n   @n11 syntax.nominal head=\"'s\"\n   @c5 syntax.clause form=nonfinite verb=\"have\"\n   @n12 syntax.nominal dependent=\"the\" head=\"marker\"\n   @c6 syntax.clause form=declarative verb=\"borders\" modifier=\"thicker\" subject=$n12\n   @r7 syntax.relation marker=\"on\" from=$c6 to=$n13\n   @n13 syntax.nominal dependent=\"the\" dependent=\"revenue\" head=\"trend\"\n   @c7 syntax.clause form=declarative modifier=\"then\" verb=\"revisit\" subject=$n14 complement=$n15\n  