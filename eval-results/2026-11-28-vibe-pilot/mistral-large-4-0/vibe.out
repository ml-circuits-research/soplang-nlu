    "id": "effect-e29f8b19-97c1-518f-a24f-931b2852e9ad",
    "sessionId": "6d47154d-937f-4420-1cdf-10e646008f43",
    "turnId": "turn-f104bf44882533022897f4feb52b084f",
    "inputEntryId": "user-turn-f104bf44882533022897f4feb52b084f-1",
