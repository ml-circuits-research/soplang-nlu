# The syntactic layer. A formalizer reads one message, with no context and no knowledge
# worlds, and writes one circuit in this schema: it splits the message into clauses and
# nominals, gives every word one place in one wire, and ties the wires. Whatever needs the
# meaning of the words (who receives, what is the result, what a pronoun refers to) is left
# to the layers that read the circuit afterwards. The names are the established terms of
# grammar and of dependency syntax.
@syntax core.module name=syntax version=3 exports=clause exports=nominal exports=relation exports=coordination

# A verb with what belongs to it, or a group of words with no verb (form=fragment).
# nonfinite: the verb form cannot make a sentence by itself ("facing left", "delete it" after "to").
@syntax.clause core.type of=syntax.clause closed=true
@syntax.clause.form core.slot of=syntax.clause key=form enum=imperative enum=declarative enum=interrogative enum=fragment enum=nonfinite required=true present=true
@syntax.clause.verb core.slot of=syntax.clause key=verb kind=string
@syntax.clause.auxiliary core.slot of=syntax.clause key=auxiliary kind=string many=true
@syntax.clause.negation core.slot of=syntax.clause key=negation kind=string many=true
# The grammatical subject, when the words show one.
@syntax.clause.subject core.slot of=syntax.clause key=subject kind=ref type=syntax.nominal type=syntax.coordination
# The other nominals the verb takes: its objects and its predicative complement. In a
# fragment: every nominal that is not the end of a relation.
@syntax.clause.complement core.slot of=syntax.clause key=complement kind=ref type=syntax.nominal type=syntax.coordination many=true
# Words that modify the clause and are neither nominals nor markers ("red", "slightly", "up").
@syntax.clause.modifier core.slot of=syntax.clause key=modifier kind=string many=true
# Words addressed to the listener, outside the grammar of the clause ("please", "hey", "thanks").
@syntax.clause.discourse core.slot of=syntax.clause key=discourse kind=string many=true
# On a fragment: the clause whose verb, auxiliaries and negation it shares ("make A blue and B green").
@syntax.clause.ellipsis core.slot of=syntax.clause key=ellipsis kind=ref type=syntax.clause

# A noun with the words that depend on it, or a word that stands where a noun could
# (a pronoun, a name, a number). A lookup: it does not say which object is meant.
@syntax.nominal core.type of=syntax.nominal closed=true
@syntax.nominal.head core.slot of=syntax.nominal key=head kind=string required=true present=true
@syntax.nominal.dependent core.slot of=syntax.nominal key=dependent kind=string many=true

# A relation between two wires. marker: the word that marks it (a preposition, the
# possessive "'s", a subordinator, the "to" of an infinitive). Without a marker the two
# wires stand together and no word says how. attachment=ambiguous: the relation belongs to
# the clause it starts at; whether it attaches to the verb or to one of the clause's
# nominals is not settled.
@syntax.relation core.type of=syntax.relation closed=true
@syntax.relation.from core.slot of=syntax.relation key=from kind=ref type=syntax.clause type=syntax.nominal type=syntax.coordination required=true present=true
@syntax.relation.to core.slot of=syntax.relation key=to kind=ref type=syntax.clause type=syntax.nominal type=syntax.coordination required=true present=true
@syntax.relation.marker core.slot of=syntax.relation key=marker kind=string many=true
@syntax.relation.negation core.slot of=syntax.relation key=negation kind=string many=true
@syntax.relation.attachment core.slot of=syntax.relation key=attachment enum=ambiguous

# Wires joined side by side: nominals, clauses or relations.
@syntax.coordination core.type of=syntax.coordination closed=true
@syntax.coordination.conjunct core.slot of=syntax.coordination key=conjunct kind=ref type=syntax.clause type=syntax.nominal type=syntax.relation many=true required=true present=true
@syntax.coordination.conjunction core.slot of=syntax.coordination key=conjunction kind=string many=true
