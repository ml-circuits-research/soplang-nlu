# The generic syntactic legend of the VSS reader. One world for every text: it names the
# places a word can stand in an nlu circuit and the few words of English whose place is
# fixed by the language. Everything else is learned from unannotated text.
@vss.legend core.module name=vss.legend version=1 language=en schema=nlu

# A station is one quoted slot of one nlu wire.
#   follows  the stations that usually come next: the reader's prior before any text is seen
#   core     the unit is complete at this station. A station that is not core must be
#            followed by one of its `follows`: anything else is read against the grain
#   closed   only listed words stand here
#   like     the station shares the words of another one
#   shape    surface shapes admitted by form alone (number, date, clock, code, mark, quote)
#            or preferred before learning (capital, upper)
#   suffix   an ending that admits an unlisted word at a closed station
#   opens    false for a station that never begins a sentence
#   after    the only stations it may come after (`start` for the beginning of a sentence)
#   ends     true for the station that closes a sentence
#   as       the kind of unit the station forms, when it is not its own name
#   clause   opens: a word here begins a new clause, so the clause before it is closed
@st.determiner vss.station unit=entity key=determiner closed=true follows=determiner follows=quantity follows=degree follows=modifier follows=noun follows=name
@st.quantity vss.station unit=entity key=quantity core=true closed=true shape=number follows=degree follows=modifier follows=noun
@st.degree vss.station unit=entity key=degree closed=true follows=degree follows=quantity follows=modifier follows=noun follows=complement
@st.modifier vss.station unit=entity key=modifier follows=modifier follows=noun
@st.noun vss.station unit=entity key=head core=true follows=noun follows=name follows=quantity follows=following
@st.name vss.station unit=entity key=name core=true closed=true shape=capital shape=upper shape=code follows=name follows=quantity follows=following
@st.pronoun vss.station unit=entity key=pronoun core=true closed=true
@st.literal vss.station unit=entity key=literal core=true closed=true shape=quote shape=date shape=clock
@st.possessive vss.station unit=entity key=possessive_marker closed=true follows=modifier follows=noun follows=name follows=quantity

@st.question vss.station clause=opens unit=clause key=question core=true closed=true follows=auxiliary follows=noun follows=modifier
@st.auxiliary vss.station unit=clause key=auxiliary core=true closed=true follows=auxiliary follows=negation follows=predicate
@st.negation vss.station unit=clause key=negation core=true closed=true follows=predicate follows=auxiliary
@st.marker vss.station clause=opens unit=clause key=marker core=true closed=true follows=predicate follows=auxiliary follows=negation follows=pronoun follows=determiner
# The word that introduces a verb completing another verb: only a verb can follow it.
@st.infinitive vss.station clause=opens unit=clause key=marker as=marker closed=true follows=predicate follows=negation follows=adverb follows=auxiliary
# A word that ties a clause to the entity or the verb before it.
@st.relative vss.station clause=opens unit=clause key=marker as=marker closed=true opens=false after=noun after=name after=pronoun after=predicate after=following after=complement after=quantity after=literal after=adverb follows=auxiliary follows=predicate follows=negation follows=pronoun follows=determiner follows=name follows=noun follows=adverb follows=modifier follows=quantity
@st.predicate vss.station unit=clause key=predicate core=true after=start after=conjunction after=separator after=marker after=infinitive after=relative after=auxiliary after=negation after=adverb after=pronoun after=filler after=expression after=question after=name
# A predicate that follows its subject stands in another neighbourhood than one that opens its clause.
@st.following vss.station unit=clause key=predicate core=true like=predicate
@st.complement vss.station unit=clause key=result_complement core=true like=modifier
@st.adverb vss.station unit=clause key=adverb core=true closed=true suffix=ly
@st.expression vss.station unit=clause key=expression core=true closed=true follows=expression
@st.filler vss.station unit=clause key=filler core=true closed=true
@st.separator vss.station clause=opens unit=clause key=separator core=true shape=mark
@st.terminator vss.station clause=opens unit=clause key=terminator core=true closed=true ends=true

@st.cue vss.station unit=relation key=cue closed=true follows=cue follows=determiner follows=quantity follows=degree follows=modifier follows=noun follows=name follows=pronoun follows=literal follows=complement follows=adverb
@st.conjunction vss.station clause=opens unit=coordination key=cue core=true closed=true

# Words whose places the language fixes. A list confines its words to the stations that
# list them. A list with open=true adds a place and confines nothing: its words keep every
# open use the text shows.
@w.determiner vss.words station=determiner word="the" word="a" word="an" word="this" word="that" word="these" word="those" word="each" word="every" word="some" word="any" word="no" word="all" word="both" word="another" word="either" word="neither" word="my" word="your" word="its" word="his" word="her" word="our" word="their" word="which" word="what" word="whose"
@w.pronoun vss.words station=pronoun word="it" word="they" word="them" word="he" word="she" word="him" word="her" word="we" word="us" word="you" word="i" word="me" word="this" word="that" word="these" word="those" word="something" word="anything" word="everything" word="nothing" word="someone" word="anyone" word="everyone" word="everybody" word="somebody" word="nobody" word="one" word="ones" word="there" word="itself" word="themselves" word="myself" word="yourself" word="what" word="who" word="whom" word="which" word="both" word="all" word="some" word="any" word="none" word="another" word="others" word="each" word="mine" word="yours" word="whatever" word="'s"
# link=subject: the word can only be the one who does what the next word says ("they differ").
@w.subject vss.words station=pronoun link=subject word="i" word="we" word="they" word="he" word="she"
# link=recipient: before a second bare entity the word is the one who receives it ("give me a hand").
@w.recipient vss.words station=pronoun link=recipient word="me" word="us" word="him" word="her" word="them"
@w.possessive vss.words station=possessive word="'s"
@w.question vss.words station=question word="what" word="which" word="who" word="whom" word="whose" word="where" word="when" word="why" word="how"
# link=nominal: a question word that stands for a thing ("what is this?"). The others ask where, when, why or how.
@w.question.nominal vss.words station=question open=true link=nominal word="what" word="which" word="who" word="whom" word="whose"
@w.auxiliary vss.words station=auxiliary word="be" word="is" word="are" word="am" word="was" word="were" word="been" word="being" word="do" word="does" word="did" word="have" word="has" word="had" word="can" word="could" word="will" word="would" word="shall" word="should" word="may" word="might" word="must" word="cannot" word="'d" word="'ll" word="'ve" word="'re" word="'m" word="'s" word="ca" word="wo"
# link=predicative: what follows the verb says what its subject is. link=infinitive: the marker
# introduces a verb that completes the verb before it.
# link=perfect: the helping verb goes with a form that says what was done ("has moved"), never with a bare verb.
@w.perfect vss.words station=auxiliary link=perfect word="have" word="has" word="had"
@w.copula vss.words station=predicate link=predicative word="be" word="is" word="are" word="am" word="was" word="were" word="been" word="being" word="'s" word="'re" word="'m"
# A verb written as two words.
@w.verb.compound vss.words station=predicate open=true word="make sure"
@w.proverb vss.words station=predicate word="do" word="does" word="did" word="have" word="has" word="had" word="like"
@w.infinitive vss.words station=infinitive link=infinitive word="to"
@w.negation vss.words station=negation word="not" word="n't" word="never" word="no"
@w.marker vss.words station=marker word="if" word="so" word="because" word="when" word="while" word="as" word="unless" word="until" word="whether" word="than" word="since" word="although" word="though" word="where" word="after" word="before"
@w.relative vss.words station=relative link=relative word="that" word="which" word="who" word="whom" word="whose"
@w.cue vss.words station=cue word="on" word="in" word="at" word="to" word="from" word="with" word="by" word="of" word="for" word="under" word="into" word="onto" word="upon" word="within" word="without" word="toward" word="towards" word="among" word="beneath" word="underneath" word="alongside" word="against" word="between" word="behind" word="beside" word="besides" word="above" word="below" word="across" word="along" word="around" word="through" word="during" word="until" word="since" word="via" word="per" word="than" word="as" word="about" word="except" word="despite" word="unlike" word="amid" word="atop" word="throughout" word="beyond" word="before" word="after" word="like" word="over" word="off" word="up" word="down" word="out"
# A listed word with a space is a compound: its words are read as one when they stand together.
@w.cue.compound vss.words station=cue word="next to" word="in front of" word="on top of" word="out of" word="instead of" word="because of" word="according to" word="due to" word="close to" word="such as" word="as well as" word="up to" word="prior to" word="regardless of" word="away from" word="apart from" word="ahead of" word="thanks to" word="in between" word="along with" word="together with" word="as for" word="as per" word="rather than" word="other than" word="in place of" word="on behalf of" word="in line with"
# link=selects: the word picks among counted things; it stands between the determiner and the count ("the first two rows").
@w.selector vss.words station=modifier open=true link=selects word="first" word="second" word="third" word="fourth" word="fifth" word="last" word="next" word="previous" word="other" word="same" word="top" word="bottom" word="left" word="right" word="middle" word="upper" word="lower" word="inner" word="outer" word="remaining"
# link=belongs: the cue says what the thing right before it is of; the relation starts at that thing.
@w.cue.belongs vss.words station=cue open=true link=belongs word="of"
@w.cue.open vss.words station=cue open=true word="near" word="inside" word="outside" word="opposite" word="past"
# link=particle: right after the verb or its object the word moves with the verb ("put it back").
@w.particle vss.words station=adverb link=particle open=true word="up" word="down" word="out" word="off" word="in" word="on" word="over" word="back" word="away" word="around" word="apart" word="together" word="through" word="along"
@w.adverb.compound vss.words station=adverb word="from now on" word="all the way" word="side by side" word="as well" word="at all" word="after all" word="at once" word="of course" word="so far" word="at least" word="at most" word="in fact" word="after that" word="before that" word="right now" word="for now" word="right away" word="straight away" word="once more" word="one more time" word="no longer" word="any more" word="anymore"
@w.degree.compound vss.words station=degree word="a bit" word="a lot" word="a little bit" word="a tad" word="a touch"
@w.question.compound vss.words station=question word="how many" word="how much"
@w.determiner.compound vss.words station=determiner word="a few" word="a couple of" word="a lot of" word="lots of" word="plenty of" word="a bunch of" word="a pair of" word="a number of" word="all of" word="some of" word="each of" word="one of" word="both of" word="none of" word="any of" word="most of" word="many of" word="half of"
@w.expression.compound vss.words station=expression word="thank you" word="thanks a lot" word="no thanks" word="never mind" word="by the way" word="good job" word="well done" word="my bad"
@w.filler vss.words station=filler word="please" word="kindly" word="uh" word="um" word="erm" word="hmm"
@w.conjunction vss.words station=conjunction word="and" word="or" word="but" word="nor" word="then" word="so" word="&" word="plus"
@w.terminator vss.words station=terminator word="." word="!" word="?"
@w.separator vss.words station=separator word="," word=";" word=":" word="—" word="–" word="-" word="." word="!" word="?" word="&"
@w.degree vss.words station=degree open=true word="approximately" word="roughly" word="nearly" word="almost" word="very" word="really" word="quite" word="rather" word="slightly" word="somewhat" word="too" word="so" word="much" word="more" word="most" word="less" word="least" word="pretty" word="super" word="extra" word="fairly" word="extremely" word="bit" word="little" word="lot" word="far" word="way" word="almost" word="nearly" word="totally" word="completely" word="entirely"
@w.quantity vss.words station=quantity open=true word="one" word="two" word="three" word="four" word="five" word="six" word="seven" word="eight" word="nine" word="ten" word="eleven" word="twelve" word="twenty" word="thirty" word="forty" word="fifty" word="hundred" word="thousand" word="dozen" word="few" word="several" word="many" word="couple" word="half" word="double" word="multiple" word="fewer"
@w.adverb vss.words station=adverb word="now" word="then" word="here" word="there" word="also" word="just" word="again" word="too" word="instead" word="already" word="still" word="only" word="even" word="maybe" word="perhaps" word="always" word="never" word="soon" word="later" word="once" word="twice" word="else" word="though" word="almost" word="somewhere" word="anywhere" word="everywhere" word="nowhere" word="afterwards" word="meanwhile" word="otherwise" word="anyway" word="somehow" word="yet" word="ever" word="often" word="sometimes" word="thus" word="hence" word="indeed" word="altogether" word="so" word="as" word="in" word="on" word="when" word="where" word="why" word="how" word="up" word="down" word="out" word="off" word="over" word="away" word="around" word="about" word="along" word="across" word="through" word="before" word="after" word="above" word="below" word="behind" word="quite" word="rather" word="much" word="more" word="less"
@w.adverb.open vss.words station=adverb open=true word="together" word="apart" word="back" word="forward" word="backward" word="forwards" word="backwards" word="next" word="straight" word="halfway" word="clockwise" word="counterclockwise" word="anticlockwise" word="sideways" word="upward" word="upwards" word="downward" word="downwards" word="inward" word="outward" word="further" word="fast" word="well" word="first" word="last" word="ahead" word="aside" word="today" word="tomorrow" word="yesterday" word="tonight" word="right" word="left" word="far" word="alone" word="likewise" word="overall" word="upside" word="inside" word="outside" word="nearby" word="higher" word="lower" word="closer" word="farther"
@w.expression vss.words station=expression open=true word="thanks" word="thank" word="hey" word="hi" word="hello" word="ok" word="okay" word="yes" word="no" word="yeah" word="yep" word="nope" word="sorry" word="cheers" word="oops" word="hmm" word="um" word="uh" word="well" word="oh" word="ah" word="wow" word="sure" word="great" word="perfect" word="nice" word="cool" word="awesome" word="lovely" word="brilliant" word="bye" word="goodbye" word="alright" word="right" word="fine" word="good"

# Endings that relate the forms of one word. Forms of one word share what is learned about them.
@forms vss.endings ending=s ending=es ending=ed ending=ing ending=er ending=est
# A form built with one of these endings from another word of the text starts out at the
# station. With confine=true it may stand only there or at the `also` station.
@forms.past vss.forms station=predicate also=modifier confine=true ending=ed
@forms.progressive vss.forms station=predicate ending=ing
@forms.graded vss.forms station=modifier ending=er ending=est
# Forms that no ending shows. Each pair is a word and a form of it; the form behaves like the
# forms the named rule builds with endings.
@irregular.past vss.irregular form=past pair="draw drawn" pair="draw drew" pair="go gone" pair="go went" pair="do done" pair="make made" pair="show shown" pair="give given" pair="give gave" pair="take taken" pair="take took" pair="hide hidden" pair="hide hid" pair="write written" pair="write wrote" pair="keep kept" pair="see seen" pair="get got" pair="get gotten" pair="bring brought" pair="build built" pair="send sent" pair="hold held" pair="stand stood" pair="sit sat" pair="run ran" pair="come came" pair="think thought" pair="know known" pair="know knew" pair="grow grown" pair="grow grew" pair="break broken" pair="break broke" pair="choose chosen" pair="choose chose" pair="fall fallen" pair="fall fell" pair="forget forgotten" pair="forget forgot" pair="drive driven" pair="drive drove" pair="eat eaten" pair="eat ate" pair="rise risen" pair="speak spoken" pair="speak spoke" pair="throw thrown" pair="throw threw" pair="fly flown" pair="fly flew" pair="blow blown" pair="blow blew" pair="hang hung" pair="lose lost" pair="mean meant" pair="pay paid" pair="sell sold" pair="spend spent" pair="stick stuck" pair="swing swung" pair="teach taught" pair="tell told" pair="say said" pair="lead led" pair="lay laid" pair="sleep slept" pair="bend bent" pair="buy bought" pair="catch caught" pair="dig dug" pair="feed fed" pair="hear heard" pair="lend lent" pair="sink sunk" pair="begin begun" pair="begin began" pair="wear worn" pair="wear wore" pair="tear torn" pair="shake shaken" pair="freeze frozen" pair="freeze froze" pair="steal stolen" pair="wake woken" pair="become became"
# A word that takes one of these endings where it heads an entity names a thing.
@forms.plural vss.forms station=noun ending=s ending=es

# Cues that work as a pair: the second starts where the first does ("from A to B").
@pair.range vss.pair first="from" second="to"
@pair.span vss.pair first="between" second="and"

# How a coordination names its kind when the text gives only a cue. joins=clause: the cue
# joins clauses, so what follows it is a clause of its own even when it has no verb.
@k.additive vss.kind unit=coordination kind=additive cue="and" cue="," cue="&" cue=";"
@k.alternative vss.kind unit=coordination kind=alternative cue="or" cue="nor"
@k.contrast vss.kind unit=coordination kind=contrast joins=clause cue="but"
@k.sequence vss.kind unit=coordination kind=sequence joins=clause cue="then" cue="so"

# How a relation between two clauses names its kind. A relation that an entity's cue
# introduces is named by the cue itself.
@k.purpose vss.kind unit=relation kind=purpose cue="so" cue="so that"
@k.condition vss.kind unit=relation kind=condition cue="if" cue="unless" cue="whether"
@k.cause vss.kind unit=relation kind=cause cue="because" cue="since"
@k.time vss.kind unit=relation kind=time cue="when" cue="while" cue="before" cue="after" cue="until" cue="once"
@k.label vss.kind unit=relation kind=label cue="called" cue="labelled" cue="labeled" cue="named" cue="titled" cue="entitled"
@k.clause vss.kind unit=relation kind=nominal_clause

# What a detached expression does.
@a.gratitude vss.kind unit=clause kind=gratitude cue="thanks" cue="thank you" cue="thanks a lot" cue="cheers"
@a.greeting vss.kind unit=clause kind=greeting cue="hey" cue="hi" cue="hello"
@a.apology vss.kind unit=clause kind=apology cue="sorry" cue="oops" cue="my bad"
@a.acknowledgment vss.kind unit=clause kind=acknowledgment cue="ok" cue="okay" cue="yes" cue="yeah" cue="yep" cue="sure" cue="alright" cue="great" cue="perfect" cue="nice" cue="cool" cue="good" cue="fine"
@a.rejection vss.kind unit=clause kind=rejection cue="no" cue="nope" cue="no thanks"
@a.hesitation vss.kind unit=clause kind=hesitation cue="um" cue="uh" cue="hmm" cue="well" cue="oh" cue="ah"
