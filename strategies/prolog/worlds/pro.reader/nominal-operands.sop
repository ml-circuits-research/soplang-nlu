# An open operand can precede the owner when the field's vocabulary licenses it.
@reader.chart.measure.prenominal pro.reader.argument_sequence family=chart act=make mode=new prefix=create prefix=make prefix=build prefix=draw prefix="show me" prefix="give me" part=a part=chart.measure part=$owner owner=chart owner=graph lexical_part=chart.measure
@reader.chart.measure.prenominal.an pro.reader.argument_sequence family=chart act=make mode=new prefix=create prefix=make prefix=build prefix=draw prefix="show me" prefix="give me" part=an part=chart.measure part=$owner owner=chart owner=graph lexical_part=chart.measure

# Common business metrics remain writable fields, so the reader uses the surface text.
@reader.chart.measure.sales core.word of=chart.measure text=sales text="total sales" text="net sales" text="gross sales" means=sales
@reader.chart.measure.revenue core.word of=chart.measure text=revenue text="total revenue" text="net revenue" text="gross revenue" means=revenue
@reader.chart.measure.profit core.word of=chart.measure text=profit text="net profit" text="gross profit" means=profit
@reader.chart.measure.margin core.word of=chart.measure text=margin text="gross margin" text="net margin" text="profit margin" means=margin
@reader.chart.measure.expense core.word of=chart.measure text=cost text=costs text=expenses text="operating expenses" means=cost
@reader.chart.measure.order core.word of=chart.measure text="order value" text="average order value" text="order count" means=orders
@reader.chart.measure.traffic core.word of=chart.measure text="page views" text="website traffic" text="session count" means=traffic
