# Alternative authored markers for a relative placement with a typed landmark.
# These forms do not enter the general marker vocabulary.
@pro.reader.landmark_surface core.type of=pro.reader.landmark_surface closed=true
@pro.reader.landmark_surface.family core.slot of=pro.reader.landmark_surface key=family kind=atom required=true
@pro.reader.landmark_surface.base core.slot of=pro.reader.landmark_surface key=base kind=string required=true
@pro.reader.landmark_surface.relation core.slot of=pro.reader.landmark_surface key=relation kind=atom required=true
@pro.reader.landmark_surface.text core.slot of=pro.reader.landmark_surface key=text kind=string required=true many=true

@reader.drawn.landmark.left_side pro.reader.landmark_surface family=drawn base="to the left of" relation=left_of text="to the left side of" text="on the left side of"
@reader.drawn.landmark.right_side pro.reader.landmark_surface family=drawn base="to the right of" relation=right_of text="to the right side of" text="on the right side of"
@reader.node.landmark.left_side pro.reader.landmark_surface family=node base="to the left of" relation=left_of text="to the left side of" text="on the left side of"
@reader.node.landmark.right_side pro.reader.landmark_surface family=node base="to the right of" relation=right_of text="to the right side of" text="on the right side of"
