# The closed pose bank describes a drawn person's pose.
@reader.nominal.person.pose pro.reader.nominal_pattern family=drawn key=drawn.pose pattern="{value}" subject_type=k.people.kind subject_type=k.people.role
@reader.nominal.person.mid_kick pro.reader.nominal_value family=drawn key=drawn.pose value=kicking text="mid kick" subject_type=k.people.kind subject_type=k.people.role
