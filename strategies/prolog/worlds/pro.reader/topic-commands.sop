# An explicitly delimited topic may serve as the selected owner of a command.
# A declaration licenses a written action cue and a finite result property.
@pro.reader.topic_command core.type of=pro.reader.topic_command closed=true
@pro.reader.topic_command.family core.slot of=pro.reader.topic_command key=family kind=atom required=true
@pro.reader.topic_command.act core.slot of=pro.reader.topic_command key=act kind=atom required=true
@pro.reader.topic_command.predicate core.slot of=pro.reader.topic_command key=predicate kind=string many=true required=true
@pro.reader.topic_command.attribute core.slot of=pro.reader.topic_command key=attribute kind=atom required=true
