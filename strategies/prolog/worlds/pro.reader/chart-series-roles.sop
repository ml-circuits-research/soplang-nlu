# Bind primary grouping, categorical series and display options to their canonical chart keys.
@reader.chart.series_column_vertical pro.reader.analytical_owner_property family=chart owner_key=chart.type owner_value=bar text="a stacked column chart" text="a grouped column chart" text="a clustered column chart" key=chart.orientation value=vertical
@reader.chart.series_stacked pro.reader.analytical_owner_property family=chart owner_key=chart.type owner_value=bar text="a stacked bar chart" text="a stacked column chart" key=chart.stacking value=stacked
@reader.chart.series_grouped pro.reader.analytical_owner_property family=chart owner_key=chart.type owner_value=bar text="a grouped bar chart" text="a grouped column chart" text="a clustered bar chart" text="a clustered column chart" key=chart.stacking value=none
@reader.chart.series_legend core.word of=chart.legend means=left text="on the left"
@reader.chart.series_legend_right core.word of=chart.legend means=right text="on the right"
@reader.chart.series_print_values core.word of=chart.show_values means=show text="with the values printed on the marks" text="with the values shown on the bars" text="with the values shown on the marks"
@reader.chart.series_split_label pro.reader.argument_label key=chart.seriesDimension text="split by" text="broken down by" text=across
@reader.chart.series_legend_label pro.reader.argument_label key=chart.legend text="put the legend" text="with the legend"

@reader.chart.series_layout pro.reader.analytical_frame family=chart layout=ordered_fields owner_key=chart.type owner_value=bar owner="a stacked bar chart" owner="a stacked column chart" owner="a grouped bar chart" owner="a grouped column chart" owner="a clustered bar chart" owner="a clustered column chart" prefix=make prefix=build prefix=draw prefix="give me" prefix="show me" prefix="maybe make" pattern="{$owner} of {chart.measure} by {chart.dimension}, broken down by {chart.seriesDimension}" pattern="{$owner} of {chart.measure} by {chart.dimension}, split by {chart.seriesDimension}" pattern="{$owner} of {chart.measure} by {chart.dimension} and {chart.seriesDimension}" pattern="{$owner} of {chart.aggregate} {chart.measure} broken down by {chart.dimension} and {chart.seriesDimension}" pattern="{$owner} of {chart.measure} across {chart.seriesDimension} for each {chart.dimension}" pattern="{$owner} of {chart.measure} by {chart.dimension}, broken down by {chart.seriesDimension}, and put the legend {chart.legend}" pattern="{$owner} of {chart.measure} by {chart.dimension}, split by {chart.seriesDimension}, with the legend {chart.legend}" pattern="{$owner} of {chart.measure} by {chart.dimension} and {chart.seriesDimension}, and put the legend {chart.legend}" pattern="{$owner} of {chart.aggregate} {chart.measure} broken down by {chart.dimension} and {chart.seriesDimension}, {chart.show_values}" pattern="{$owner} of {chart.measure} by {chart.seriesDimension} and {chart.dimension}" pattern="{$owner} of {chart.aggregate} {chart.measure} broken down by {chart.seriesDimension} and {chart.dimension}" pattern="{$owner} of {chart.measure} by {chart.seriesDimension} and {chart.dimension}, and put the legend {chart.legend}" pattern="{$owner} of {chart.aggregate} {chart.measure} broken down by {chart.seriesDimension} and {chart.dimension}, {chart.show_values}" open_boundary=or open_boundary="so the" open_boundary=except open_boundary=for open_boundary="with the" open_boundary="put the legend"

# Repeated open fields must name the same written field in the qualification.
@reader.chart.stack_share_label pro.reader.argument_label key=chart.stacking text="the stacks show"
@reader.chart.stack_share core.word of=chart.stacking means=percent text="share rather than absolute" text="share instead of absolute"
@reader.chart.series_normalized pro.reader.analytical_frame family=chart layout=ordered_fields owner_key=chart.type owner_value=bar owner="a stacked bar chart" owner="a stacked column chart" prefix=make prefix=build prefix=draw prefix="give me" prefix="show me" pattern="{$owner} of {chart.measure} across {chart.seriesDimension} for each {chart.dimension}, so the stacks show {=chart.seriesDimension} {chart.stacking} {=chart.measure}" open_boundary=or open_boundary=except scope_literal_slot=chart.stacking scope_literal="share rather than absolute" scope_literal="share instead of absolute"
