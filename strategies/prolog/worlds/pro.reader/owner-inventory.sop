# An explicit property owner can be named by the drawing object inventory.
@reader.owner.drawn_kind pro.reader.owner_inventory family=drawn act=change provider=k.objects.object

# Named avatar components are parts. The grammar binds a written property to
# the selected component and leaves instance lookup to the application.
@reader.owner.face_part pro.reader.owner_inventory family=part act=change provider=k.faces.part
@reader.owner.face_slot pro.reader.owner_inventory family=part act=change provider=k.faces.slot
