# A modifier immediately before one of these relations can also convey proximity.
@pro.reader.spatial_modifier core.type of=pro.reader.spatial_modifier closed=true
@pro.reader.spatial_modifier.prefix core.slot of=pro.reader.spatial_modifier key=prefix kind=string many=true required=true
@pro.reader.spatial_modifier.base core.slot of=pro.reader.spatial_modifier key=base kind=atom many=true required=true
@pro.reader.spatial_modifier.additional core.slot of=pro.reader.spatial_modifier key=additional kind=atom required=true
@reader.en.spatial.close_direction pro.reader.spatial_modifier prefix=just prefix=immediately base=left_of base=right_of base=above base=below additional=near
