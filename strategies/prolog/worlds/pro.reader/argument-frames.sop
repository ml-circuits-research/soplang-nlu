# Chart argument order and connector wording are explicit. Written field names are open spans.
@reader.chart.scatter.colour_mapping pro.reader.argument_sequence family=chart act=make mode=new prefix="give me" prefix="show me" prefix="make" prefix="draw" prefix="try" prefix="i need to see" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" owner_key=chart.type owner_value=scatter part="$owner" part=of part=chart.yField part=against part=chart.xField part="," part="coloured by" part=chart.colourBy tail="for the"
@reader.chart.scatter.overlay_colour_mapping pro.reader.argument_sequence family=chart act=make mode=new prefix="give me" prefix="show me" prefix="make" prefix="draw" prefix="try" prefix="i need to see" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" owner_key=chart.type owner_value=scatter part="$owner" part=of part=chart.yField part=against part=chart.xField part=chart.compare part="," part="coloured by" part=chart.colourBy tail="for the"
@reader.chart.scatter.regression pro.reader.argument_sequence family=chart act=make mode=new prefix="give me" prefix="show me" prefix="make" prefix="draw" prefix="try" prefix="i need to see" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" owner_key=chart.type owner_value=scatter part="$owner" part=of part=chart.yField part="plotted by" part=chart.xField part="," part=chart.trendLine tail=","
# Bare coordination does not establish which field belongs on which axis.
@reader.chart.scatter.coordinated_fields pro.reader.analytical_frame family=chart layout=ordered_fields owner_key=chart.type owner_value=scatter prefix="give me" prefix="show me" prefix=make prefix=draw prefix=try prefix="i need to see" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" tail="," tail=with tail="label the" tail="title the" open_boundary="label the" open_boundary="title the" pattern="{$owner} of {chart.xField} and {chart.yField}" pattern="{$owner} of {chart.yField} and {chart.xField}"
@reader.chart.scatter.ordered_fields pro.reader.analytical_frame family=chart layout=ordered_fields owner_key=chart.type owner_value=scatter prefix="give me" prefix="show me" prefix=build prefix=make prefix=draw prefix=try prefix="i need to see" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" tail="," tail=with pattern="{$owner} of {chart.yField} against {chart.xField}" pattern="{$owner} of {chart.yField} plotted by {chart.xField}"
@reader.chart.scatter.colour_owner pro.reader.argument_sequence family=chart act=make mode=new prefix="let's do" prefix="make" prefix="give me" prefix="show me" prefix="try" owner="a scatter plot" owner="scatter plot" owner="a scatter chart" owner_key=chart.type owner_value=scatter part="$owner" part=with part=chart.colourBy part="deciding the colour of each mark"
@reader.chart.line.period_aggregate pro.reader.argument_sequence family=chart act=make mode=new prefix="try" prefix="make" prefix="show" prefix="show me" prefix="give me" owner="a line chart" owner="line chart" owner_key=chart.type owner_value=line part="$owner" part=of part=chart.period part=chart.aggregate part=of part=chart.measure
@reader.chart.bar.trailing_owner pro.reader.argument_sequence family=chart act=make mode=new prefix="show" prefix="show me" prefix="give me" prefix="we want" prefix="display" owner="a bar chart" owner="bar chart" owner_key=chart.type owner_value=bar part=chart.aggregate part=chart.measure part=versus part=chart.dimension part=as part="$owner"
@reader.chart.existing_aggregate pro.reader.argument_sequence family=chart act=change mode=existing prefix="show" owner=chart part=the part=chart.aggregate part=of part=chart.measure part=on part=the part="$owner"
# Fixed phrases support the canonical effect only; the complete written wording remains attached.
@reader.chart.line.year_on_year core.word text=year-on-year means=year of=chart.period
@reader.chart.aggregate.averages core.word text=averages means=avg of=chart.aggregate
@reader.chart.scatter.linear_fit core.word text="with a regression line" text="with a regression line through it" text="with a fitted regression line" means=show of=chart.trendLine
@reader.chart.scatter.overlay core.word text="shown together" means=overlay of=chart.compare
@reader.chart.scatter.x_field_label pro.reader.argument_label key=chart.xField text=against text="plotted by"
@reader.chart.scatter.colour_field_label pro.reader.argument_label key=chart.colourBy text="coloured by" text="colored by"
