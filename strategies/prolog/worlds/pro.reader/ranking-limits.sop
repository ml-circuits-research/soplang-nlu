# Ranking limits use the same count grammar for existing and requested values.
@reader.chart.top.format pro.reader.argument_format family=chart key=chart.top format=positive_count
@reader.chart.bottom.format pro.reader.argument_format family=chart key=chart.bottom format=positive_count
@reader.chart.top.label pro.reader.argument_label key=chart.top text=top
@reader.chart.bottom.label pro.reader.argument_label key=chart.bottom text=bottom

