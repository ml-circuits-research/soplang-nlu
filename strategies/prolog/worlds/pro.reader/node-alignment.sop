# Matching edges of existing nodes expresses relative arrangement.
@reader.align.edge.top core.word of=node.edge means=top text="top edge" text="top edges"
@reader.align.edge.bottom core.word of=node.edge means=bottom text="bottom edge" text="bottom edges"
@reader.align.edge.left core.word of=node.edge means=left text="left edge" text="left edges"
@reader.align.edge.right core.word of=node.edge means=right text="right edge" text="right edges"
@reader.align.edge.horizontal_centre core.word of=node.edge means=centre text="horizontal centre" text="horizontal centres" text="horizontal center" text="horizontal centers"

@reader.align.edges.of_members pro.reader.argument_sequence family=node act=place mode=existing request_mode=arrange mode_marker="into line" prefix=bring owner=node owner=nodes owner=box owner=boxes owner="the nodes" owner="the boxes" part=the part=node.edge part=of part="$owner" part="into line"
@reader.align.edge.context pro.reader.argument_sequence family=node act=place mode=existing request_mode=arrange contextual_owner=true predicate_surface=aligned part=node.edge part="$predicate"
