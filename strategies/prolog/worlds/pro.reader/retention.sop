@reader.retention.place pro.reader.retention cue=reaction.keep lead=keep lead=leave adjunct=keeping adjunct=leaving tail="where it is" tail="where they are" value=place remainder="everything else" remainder="the rest" remainder="the rest of the scene" remainder="all other objects"
@reader.retention.all pro.reader.retention cue=reaction.keep lead=keep lead=leave adjunct=keeping adjunct=leaving tail="as it is" tail="as they are" tail="exactly as it is" tail="exactly as they are" tail=unchanged value=all remainder="everything else" remainder="the rest" remainder="the rest of the scene" remainder="all other objects"
