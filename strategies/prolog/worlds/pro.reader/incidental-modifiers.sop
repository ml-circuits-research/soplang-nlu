# An exact comma-delimited qualifier stays attached to the preceding request.
@pro.reader.incidental_modifier core.type of=pro.reader.incidental_modifier closed=true
@pro.reader.incidental_modifier.text core.slot of=pro.reader.incidental_modifier key=text kind=string many=true required=true
@reader.modifier.clarity pro.reader.incidental_modifier text="clear as day" text="plain as day" text="clear as crystal" text="crystal clear"
