# Explicit roles for a complete creation clause with a written complement.
@reader.creation.node.label pro.reader.creation_role family=node attribute=node.label sort_key=node.kind sort_key=node.shape preposed=true text=labelled text=labeled text=marked text=called text=named text="with the name"
@reader.creation.section.heading pro.reader.creation_role family=section attribute=section.content sort=heading text=called text=named text=titled text=saying
@reader.creation.section.content pro.reader.creation_role family=section attribute=section.content sort=paragraph sort=quote text=saying text=containing
@reader.creation.person.name pro.reader.creation_role family=person attribute=person.name value_type=k.people.given_name
