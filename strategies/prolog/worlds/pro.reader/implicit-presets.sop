# The written target and result bank license a preset assignment.
@reader.avatar.preset.change pro.reader.argument_sequence family=drawn act=change mode=existing prefix=set prefix=change prefix=switch owner=avatar part="$owner" part=to part=drawn.preset tail="and keep"
@reader.avatar.preset.fragment pro.reader.argument_sequence family=drawn act=change mode=existing owner=avatar part="$owner" part=to part=drawn.preset
@reader.avatar.preset.older_man core.word of=drawn.preset means="old man" text="elderly man" text="an elderly man" text="an old man"
@reader.avatar.preset.older_woman core.word of=drawn.preset means="old woman" text="elderly woman" text="elderly lady" text="an elderly woman" text="an elderly lady" text="an old woman"
@reader.avatar.preset.robot core.word of=drawn.preset means=robot text="a robot"
