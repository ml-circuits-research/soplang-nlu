@reader.effect.chart.bar_orientation pro.reader.effect_sense family=chart key=chart.horizontal text=bars alias="horizontal=on" alias="vertical=off"
@reader.effect.chart.error_caps pro.reader.effect_sense family=chart key=chart.errorCap text="cap size" text="error bar cap size" scale=size
