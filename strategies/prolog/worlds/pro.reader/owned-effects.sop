@pro.reader.effect_sense.finite_choice core.slot of=pro.reader.effect_sense key=finite_choice kind=boolean
@pro.reader.effect_sense.ellipsis core.slot of=pro.reader.effect_sense key=ellipsis enum=bare enum=labelled
