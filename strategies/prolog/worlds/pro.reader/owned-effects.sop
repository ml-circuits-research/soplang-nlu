@reader.effect.chart.marker_size pro.reader.effect_sense family=chart key=chart.markerSize text=markers text="marker size" scale=size
@reader.effect.chart.grid_style pro.reader.effect_sense family=chart key=chart.gridStyle text="grid line style" text="grid lines" alias="dashes=dashed" alias="dots=dotted"
@reader.effect.chart.grid_axis pro.reader.effect_sense family=chart key=chart.gridAxis text="grid lines" alias="both directions=both"
