# Surface patterns belong to the language. Property senses and admissible
# values are checked separately in the existing owner's family.
@pro.reader.owned_effect core.type of=pro.reader.owned_effect closed=true
@pro.reader.owned_effect.operation core.slot of=pro.reader.owned_effect key=operation enum=set enum=show enum=hide required=true
@pro.reader.owned_effect.pattern core.slot of=pro.reader.owned_effect key=pattern kind=string many=true required=true
@pro.reader.owned_effect.property_command core.slot of=pro.reader.owned_effect key=property_command kind=boolean
@pro.reader.owned_effect.cue core.slot of=pro.reader.owned_effect key=cue kind=string many=true
@pro.reader.owned_effect.open_text core.slot of=pro.reader.owned_effect key=open_text kind=boolean
@pro.reader.owned_effect.inherit_owner core.slot of=pro.reader.owned_effect key=inherit_owner kind=boolean
@pro.reader.owned_effect.want core.slot of=pro.reader.owned_effect key=want enum=no
@reader.effect.object_and_value pro.reader.owned_effect operation=set pattern="set the {property} on {owner} to {value}" pattern="make the {property} on {owner} {value}" pattern="the {property} on {owner} should be {value}" pattern="the {property} on {owner} should be a bit {value}" pattern="the {property} on {owner} should be one step {value}" pattern="do the {property} {value} on {owner}" pattern="turn the {property} on {owner} {value}" pattern="use {value} {property} on {owner}"
@reader.effect.position pro.reader.owned_effect operation=set pattern="put the {property} on the {value} of {owner}" pattern="move the {property} to the {value} of {owner}" pattern="put the {property} on the {value}" pattern="{property} on the {value}"
@reader.effect.position_unstated_owner pro.reader.owned_effect operation=set pattern="move the {property} to the {value}" pattern="move the {property} on the {value}" pattern="{property} at the {value}"
@reader.effect.explicit_assignment pro.reader.owned_effect operation=set pattern="set the {property} of {owner} to {value}"
@reader.effect.property_continuation pro.reader.owned_effect operation=set inherit_owner=true pattern="{property} to {value}"
@reader.effect.change pro.reader.owned_effect operation=set pattern="set the {property} to {value}" pattern="set the {property} {value}" pattern="make the {property} {value}" pattern="{property} {value}" pattern="{property} {value} instead of {prior}" pattern="the {property} {value} instead of {prior}"
@reader.effect.excluded_choice pro.reader.owned_effect operation=set want=no pattern="set the {value} not {property}" pattern="make the {value} not {property}"
@reader.effect.requested_value pro.reader.owned_effect operation=set pattern="try the {property} {value}" pattern="turn the {property} {value}" pattern="the {property} should be {value}"
@reader.effect.desired_owner_value pro.reader.owned_effect operation=set pattern="the {property} on {owner} want to be {value}" pattern="the {property} on {owner} wants to be {value}"
@reader.effect.named_value pro.reader.owned_effect operation=set pattern="use a {value} {property} on {owner}" pattern="how about a {value} {property} on {owner}"
@reader.effect.open_text pro.reader.owned_effect operation=set open_text=true pattern="add a {property} {value} to {owner}" pattern="give {owner} the {property} {value}"
@reader.effect.property_command pro.reader.owned_effect operation=set property_command=true pattern="{property} {owner} {value}"
@reader.effect.visible pro.reader.owned_effect operation=show pattern="put a {property} on {owner}" pattern="add a {property} to {owner}" pattern="show the {property} on {owner}" pattern="turn on {property} for {owner}" pattern="show {property}"
@reader.effect.hidden pro.reader.owned_effect operation=hide pattern="hide the {property}" pattern="hide the {property} on {owner}" pattern="remove the {property} from {owner}"

