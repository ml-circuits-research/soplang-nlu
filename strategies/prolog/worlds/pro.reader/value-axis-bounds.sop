# These commands set the value-axis bounds of an existing chart on the page.
@reader.chart.axis.minimum_format pro.reader.argument_format family=chart key=chart.min format=scalar_number
@reader.chart.axis.maximum_format pro.reader.argument_format family=chart key=chart.max format=scalar_number

@reader.chart.axis.minimum pro.reader.argument_sequence family=chart act=change mode=existing contextual_owner=true predicate_surface="start the y axis at" predicate_surface="start the y-axis at" predicate_surface="start the value axis at" predicate_surface="begin the y axis at" predicate_surface="begin the y-axis at" predicate_surface="begin the value axis at" predicate_surface="make the y axis start at" predicate_surface="make the y-axis start at" predicate_surface="make the value axis start at" predicate_surface="set the y axis minimum to" predicate_surface="set the y-axis minimum to" predicate_surface="set the value axis minimum to" part="$predicate" part=chart.min structured_part=chart.min
@reader.chart.axis.maximum pro.reader.argument_sequence family=chart act=change mode=existing contextual_owner=true predicate_surface="end the y axis at" predicate_surface="end the y-axis at" predicate_surface="end the value axis at" predicate_surface="stop the y axis at" predicate_surface="stop the y-axis at" predicate_surface="stop the value axis at" predicate_surface="make the y axis end at" predicate_surface="make the y-axis end at" predicate_surface="make the value axis end at" predicate_surface="set the y axis maximum to" predicate_surface="set the y-axis maximum to" predicate_surface="set the value axis maximum to" part="$predicate" part=chart.max structured_part=chart.max

@reader.chart.axis.range pro.reader.argument_sequence family=chart act=change mode=existing contextual_owner=true predicate_surface="make the y axis range" predicate_surface="make the y-axis range" predicate_surface="make the value axis range" predicate_surface="make the y axis range from" predicate_surface="make the y-axis range from" predicate_surface="make the value axis range from" predicate_surface="set the y axis range from" predicate_surface="set the y-axis range from" predicate_surface="set the value axis range from" predicate_surface="set the y axis from" predicate_surface="make the y axis from" predicate_surface="start the y axis from" part="$predicate" part=chart.min part=to part=chart.max structured_part=chart.min structured_part=chart.max ordered_numeric_pair=true
@reader.chart.axis.between pro.reader.argument_sequence family=chart act=change mode=existing contextual_owner=true predicate_surface="set the y axis range between" predicate_surface="set the y-axis range between" predicate_surface="set the value axis range between" part="$predicate" part=chart.min part=and part=chart.max structured_part=chart.min structured_part=chart.max ordered_numeric_pair=true
@reader.chart.axis.start_stop pro.reader.argument_sequence family=chart act=change mode=existing contextual_owner=true predicate_surface="start the y axis at" predicate_surface="start the y-axis at" predicate_surface="start the value axis at" part="$predicate" part=chart.min part="and stop at" part=chart.max structured_part=chart.min structured_part=chart.max ordered_numeric_pair=true
@reader.chart.axis.stop_label pro.reader.argument_label key=chart.max text="stop at"

@reader.chart.axis.start_cap pro.reader.argument_sequence family=chart act=change mode=existing contextual_owner=true predicate_surface="start the y axis at" predicate_surface="start the y-axis at" predicate_surface="start the value axis at" part="$predicate" part=chart.min part="and cap it at" part=chart.max structured_part=chart.min structured_part=chart.max ordered_numeric_pair=true
@reader.chart.axis.upper.cap.label pro.reader.argument_label key=chart.max text="cap it at"
