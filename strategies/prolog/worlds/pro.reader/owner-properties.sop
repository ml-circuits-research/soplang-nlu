# A written shape name can identify an existing entity in a property change.
@reader.owner.diagram.shape pro.reader.owner_sort family=node act=change slot=w.diagram.node.shape

# These numeric operands can carry an explicit length unit. The reader keeps
# that unit. Conversion to the document's page units needs application context.
@reader.quantity.node.width pro.reader.property_quantity family=node key=node.width quantity=length
@reader.quantity.node.height pro.reader.property_quantity family=node key=node.height quantity=length
