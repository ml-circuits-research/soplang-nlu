# A definite article in a spatial value marks the boundary of that value.
@reader.effect.attribute_side pro.reader.owned_effect operation=set pattern="{property} on the {value}"
@reader.effect.retain_value_state pro.reader.owned_effect operation=set pattern="keep {property} {value}"

@reader.effect.chart.mark_value_visibility pro.reader.effect_sense family=chart key=chart.show_values text=values
@reader.effect.chart.mark_values_shown core.word of=w.diagram.group.value_labels text=shown means=show
