@pro.reader.target_inventory.provider core.slot of=pro.reader.target_inventory key=provider kind=atom required=true
@pro.reader.target_inventory.identity core.slot of=pro.reader.target_inventory key=identity kind=atom required=true
@pro.reader.target_inventory.requires core.slot of=pro.reader.target_inventory key=requires kind=atom
@pro.reader.target_inventory.argument_role core.slot of=pro.reader.target_inventory key=argument_role kind=atom

