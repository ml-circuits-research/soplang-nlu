# Number agreement for universally quantified owners and targets.
@pro.reader.universal_agreement core.type of=pro.reader.universal_agreement closed=true
@pro.reader.universal_agreement.text core.slot of=pro.reader.universal_agreement key=text kind=string many=true required=true
@pro.reader.universal_agreement.number core.slot of=pro.reader.universal_agreement key=number enum=sg enum=pl required=true
@reader.universal_agreement.distributive pro.reader.universal_agreement number=sg text=every text="every single" text=each
@reader.universal_agreement.plural pro.reader.universal_agreement number=pl text=all text="all the" text="all of the" text="every one of the" text="each of the"
