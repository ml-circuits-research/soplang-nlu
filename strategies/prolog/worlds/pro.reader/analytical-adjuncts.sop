# A finite setting or numeric operand modifies one already-proved creation.
@pro.reader.analytical_adjunct core.type of=pro.reader.analytical_adjunct closed=true
@pro.reader.analytical_adjunct.family core.slot of=pro.reader.analytical_adjunct key=family kind=atom required=true
@pro.reader.analytical_adjunct.key core.slot of=pro.reader.analytical_adjunct key=key kind=atom required=true
@pro.reader.analytical_adjunct.value core.slot of=pro.reader.analytical_adjunct key=value kind=atom
@pro.reader.analytical_adjunct.pattern core.slot of=pro.reader.analytical_adjunct key=pattern kind=string required=true many=true

@reader.chart.adjunct.grid pro.reader.analytical_adjunct family=chart key=chart.grid value=show pattern="with gridlines" pattern="with grid lines" pattern="with gridlines behind it" pattern="with gridlines behind the bars"
@reader.chart.adjunct.values pro.reader.analytical_adjunct family=chart key=chart.show_values value=show pattern="with values shown on the bars" pattern="with the values shown on the bars" pattern="with the values shown at the points"
@reader.chart.adjunct.legend_left pro.reader.analytical_adjunct family=chart key=chart.legend value=left pattern="with the legend on the left" pattern="legend on the left"
@reader.chart.adjunct.legend_right pro.reader.analytical_adjunct family=chart key=chart.legend value=right pattern="with the legend on the right" pattern="legend on the right"
@reader.chart.adjunct.min pro.reader.analytical_adjunct family=chart key=chart.min pattern="with the y axis starting at {number}" pattern="with the y axis beginning at {number}" pattern="start the y axis at {number}"
@reader.chart.adjunct.max pro.reader.analytical_adjunct family=chart key=chart.max pattern="with the y axis ending at {number}" pattern="end the y axis at {number}"
@reader.chart.adjunct.fit pro.reader.analytical_adjunct family=chart key=chart.trendLine value=show pattern="with a regression line" pattern="with a fitted regression line" pattern="with a regression line through it"
